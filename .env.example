# RC-GPT — required environment variables
# Copy this file to .env and fill in your values before running.

# ── Google Gemini Developer API ──────────────────────────────────────────────
# Get your key at https://aistudio.google.com/apikey (free tier available)
# This is NOT a service-account JSON file — it is a plain API key string.
GOOGLE_API_KEY=your-google-api-key-here

# ── Pinecone Vector Database ─────────────────────────────────────────────────
# Sign up at https://pinecone.io (free Serverless tier available)
# After creating an index named "caselawgpt-index" (dimension 768, cosine), paste the key below.
PINECONE_API_KEY=your-pinecone-api-key-here

# ── CORS (production only) ────────────────────────────────────────────────────
# Comma-separated list of frontend origins the backend will accept.
# Add your Vercel URL here once the frontend is deployed.
ALLOWED_ORIGINS=https://rcgpt.vercel.app,http://localhost:3000,http://localhost:5173
